APP_ENV=development
HTTP_ADDR=:3000
PUBLIC_BASE_URL=https://api.example.com
SURREAL_URL=https://surrealdb.example.com
SURREAL_NAMESPACE=replace-me
SURREAL_DATABASE=replace-me
SURREAL_USERNAME=replace-me
SURREAL_PASSWORD=replace-me
SURREAL_PROXY_TOKEN=replace-with-a-random-64-character-token
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-at-least-32-random-characters
OTP_MODE=development
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Firebase Cloud Messaging (opsiyonel, push aktif etmek için)
# FIREBASE_PROJECT_ID=my-project-123
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"my-project-123",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64-encoded-service-account-json
